{
  "name": "gas-tracker",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "concurrently -k -n api,web -c cyan,magenta \"node server.js\" \"vite\"",
    "dev:web": "vite",
    "prebuild": "node scripts/generate-sitemap.mjs",
    "build": "vite build",
    "lint": "eslint .",
    "preview": "vite preview",
    "start": "node server.js",
    "db:up": "docker start tanke-pg 2>/dev/null || docker run -d --name tanke-pg -e POSTGRES_USER=tanke -e POSTGRES_PASSWORD=tanke -e POSTGRES_DB=tanke -p 127.0.0.1:5433:5432 postgres:16-alpine",
    "prisma:migrate": "prisma migrate deploy",
    "prisma:generate": "prisma generate",
    "sitemap": "node scripts/generate-sitemap.mjs",
    "og": "node scripts/generate-og.mjs",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "prisma": {
    "seed": "node prisma/seed.js"
  },
  "dependencies": {
    "@maplibre/maplibre-gl-leaflet": "^0.1.4",
    "@prisma/client": "6.12.0",
    "bcryptjs": "^3.0.2",
    "cookie-parser": "^1.4.7",
    "dotenv": "^16.6.1",
    "express": "^5.2.1",
    "express-rate-limit": "^8.7.0",
    "leaflet": "^1.9.4",
    "maplibre-gl": "^6.10.0",
    "nodemailer": "^10.0.10",
    "prisma": "6.12.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-leaflet": "^5.0.0",
    "react-router-dom": "^7.18.4"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "@resvg/resvg-js": "^2.6.2",
    "@tailwindcss/postcss": "^4.1.18",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^5.1.1",
    "autoprefixer": "^10.4.24",
    "concurrently": "^9.2.1",
    "eslint": "^9.39.1",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.4.24",
    "globals": "^16.5.0",
    "postcss": "^8.5.6",
    "sharp": "^0.35.3",
    "tailwindcss": "^4.1.18",
    "vite": "^7.2.4",
    "vite-plugin-pwa": "^1.2.0",
    "vitest": "^4.1.11"
  }
}
