# Copia a .env para desarrollo local (npm run db:up && npm run dev)
DATABASE_URL=postgresql://tanke:tanke@127.0.0.1:5433/tanke
# Opcionales: solo crean el primer administrador si todavía no existe ninguno.
ADMIN_EMAIL=
ADMIN_PASSWORD=
PORT=3003
SNAPSHOT_PROVINCES=35,38

# Correo transaccional (recuperar contrasena). Sin SMTP_URL los emails
# se imprimen por consola y el flujo se puede probar igualmente.
APP_URL=http://localhost:3003
# SMTP_URL=smtp://usuario:clave@smtp.resend.com:587
EMAIL_FROM=Tanke <no-reply@mail.javistudio.dev>

# CSP: sin esto el navegador solo informa (Content-Security-Policy-Report-Only).
# Poner true cuando el log lleve una temporada sin informes inesperados.
# CSP_ENFORCE=true

# Asistente de búsqueda en lenguaje natural (Claude Haiku). De pago: sin clave
# el buscador no lo enseña. Pon un límite de gasto en la Console de Anthropic.
# ANTHROPIC_API_KEY=
# Consultas a Claude al día (las repetidas salen de caché y no cuentan).
# ASSISTANT_DAILY_LIMIT=1000
